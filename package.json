{
  "name": "inkless",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "panda codegen && tsc -b && PANDA_HASH=1 vite build && panda codegen",
    "postinstall": "panda codegen",
    "check": "npm run lint && panda codegen && tsc -b",
    "lint": "oxlint --threads 1",
    "type-check": "tsc --noEmit",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@pandacss/dev": "2.1.2",
    "@pandacss/eslint-plugin": "2.1.2",
    "@pandacss/preset-base": "2.1.2",
    "@pandacss/preset-panda": "2.1.2",
    "@pandacss/vite": "2.1.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "oxlint": "1.81.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "@ark-ui/react": "5.39.2",
    "escpos-web-print": "^0.1.0",
    "jsbarcode": "^3.12.3",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
