{
  "id": "quote",
  "version": 1,
  "name": "Quote card",
  "hint": "Big quote marks, small attribution",
  "fields": [
    {
      "key": "quote",
      "label": "Quote",
      "type": "longtext",
      "default": "Write the line you want to keep on your desk."
    },
    {
      "key": "author",
      "label": "Who said it",
      "type": "text",
      "default": "Who said it"
    },
    {
      "key": "mark",
      "label": "Quote mark",
      "type": "select",
      "default": "“",
      "options": [
        "“",
        "”",
        "«",
        "\""
      ]
    },
    {
      "key": "show_author",
      "label": "Show author",
      "type": "toggle",
      "default": true
    }
  ],
  "doc": {
    "version": 1,
    "name": "Quote card",
    "landscape": false,
    "length": 600,
    "autoLength": true,
    "endSpace": 96,
    "elements": [
      {
        "kind": "text",
        "x": 0,
        "w": 384,
        "h": 30,
        "rotation": 0,
        "invert": false,
        "font": "Archivo Black",
        "size": 140,
        "weight": 400,
        "italic": false,
        "align": "left",
        "lineHeight": 0.9,
        "letterSpacing": 0,
        "y": 0,
        "text": "{{mark}}"
      },
      {
        "kind": "text",
        "x": 0,
        "w": 384,
        "h": 30,
        "rotation": 0,
        "invert": false,
        "font": "Zen Kaku Gothic New",
        "size": 32,
        "weight": 900,
        "italic": false,
        "align": "left",
        "lineHeight": 1.3,
        "letterSpacing": 0,
        "y": 110,
        "text": "{{quote}}"
      },
      {
        "kind": "shape",
        "x": 0,
        "w": 96,
        "h": 8,
        "rotation": 0,
        "invert": false,
        "shape": "line",
        "fill": "solid",
        "stroke": 4,
        "radius": 0,
        "y": 290
      },
      {
        "kind": "text",
        "x": 0,
        "w": 384,
        "h": 30,
        "rotation": 0,
        "invert": false,
        "font": "Caveat",
        "size": 30,
        "weight": 700,
        "italic": false,
        "align": "left",
        "lineHeight": 1.25,
        "letterSpacing": 0,
        "y": 310,
        "text": "{{author}}",
        "when": "show_author"
      }
    ],
    "print": {
      "heat": 0,
      "copies": 1,
      "darkness": 128
    }
  }
}
