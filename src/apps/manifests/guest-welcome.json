{
  "id": "guest-welcome",
  "version": 1,
  "name": "Guest welcome",
  "hint": "Welcome sheet for guests with stay dates, Wi-Fi QR, door code and house rules",
  "fields": [
    {
      "key": "guest_name",
      "label": "Guest name",
      "type": "text",
      "default": "",
      "required": true,
      "perGuest": true
    },
    {
      "key": "welcome_message",
      "label": "Welcome message",
      "type": "longtext",
      "default": "We are so glad you are here. Make yourself at home."
    },
    {
      "key": "arrival_date",
      "label": "Arrival date",
      "type": "date",
      "default": "",
      "required": true,
      "perGuest": true
    },
    {
      "key": "departure_date",
      "label": "Departure date",
      "type": "date",
      "default": "",
      "required": true,
      "perGuest": true
    },
    {
      "key": "checkin_time",
      "label": "Check-in from",
      "type": "time",
      "default": "15:00"
    },
    {
      "key": "checkout_time",
      "label": "Check-out by",
      "type": "time",
      "default": "10:00"
    },
    {
      "key": "wifi_name",
      "label": "Wi-Fi network",
      "type": "text",
      "default": "Your network",
      "required": true
    },
    {
      "key": "wifi_password",
      "label": "Wi-Fi password",
      "type": "password",
      "default": "your-password",
      "required": true
    },
    {
      "key": "room_number",
      "label": "Room",
      "type": "text",
      "default": "101"
    },
    {
      "key": "door_pin",
      "label": "Door code",
      "type": "password",
      "default": "",
      "required": true,
      "perGuest": true
    },
    {
      "key": "access_notes",
      "label": "Access notes",
      "type": "longtext",
      "default": "The door locks by itself when it closes."
    },
    {
      "key": "house_rules",
      "label": "House rules",
      "type": "longtext",
      "default": "Quiet hours 22:00 to 8:00\nNo smoking indoors\nShoes off at the entrance\nPlease sort your rubbish"
    },
    {
      "key": "appliances",
      "label": "Appliances",
      "type": "longtext",
      "default": "Air conditioner: remote on the wall by the bed\nWashing machine: detergent under the sink\nHot water: switch next to the bathroom door"
    },
    {
      "key": "checklist",
      "label": "Before you leave",
      "type": "list",
      "columns": [
        {
          "key": "item",
          "label": "Task",
          "type": "text"
        }
      ],
      "format": "□ {item}",
      "default": [
        {
          "item": "Take the rubbish out"
        },
        {
          "item": "Turn off the air conditioner"
        },
        {
          "item": "Close the windows"
        },
        {
          "item": "Leave the key on the table"
        }
      ]
    }
  ],
