{
  "id": "lovelive-setlist",
  "version": 1,
  "name": "Love Live setlist",
  "hint": "Import a performance from LLerNote and print its full running order",
  "importer": {
    "type": "performance-setlist",
    "name": "LLerNote",
    "sources": {
      "performances": "https://raw.githubusercontent.com/hamproductions/llernote/main/data/performance-info.json",
      "extras": "https://raw.githubusercontent.com/hamproductions/llernote/main/data/event-extra.json",
      "setlists": "https://raw.githubusercontent.com/hamproductions/llernote/main/data/performance-setlists.json",
      "songs": "https://raw.githubusercontent.com/hamproductions/llernote/main/data/song-info.json"
    },
    "output": {
      "fields": {
        "event": { "from": ["tourName"], "separator": " " },
        "performance": { "from": ["concertName", "performanceName"], "separator": " / " },
        "date": { "from": ["date", "startTime"], "separator": " " },
        "venue": { "from": ["venue"], "separator": " " }
      },
      "setlist": "setlist",
      "status": "status",
      "source": "source",
      "structured": true,
      "artwork": "artwork"
    },
    "format": {
      "section": "\n{name}\n",
      "song": "{number} {title}",
      "actual": "Actual setlist",
      "provisional": "Provisional setlist"
    },
    "artwork": {
      "source": "https://raw.githubusercontent.com/hamproductions/llernote/main/data/live-thumb-info.json",
      "keys": ["{id}", "tour:{tourName}"],
      "image": "file",
      "url": "https://raw.githubusercontent.com/hamproductions/llernote/main/public/assets/lives/{image}.webp"
    }
  },
  "fields": [
    { "key": "event", "label": "Event", "type": "longtext", "default": "", "required": true },
    { "key": "performance", "label": "Performance", "type": "text", "default": "" },
    { "key": "date", "label": "Date and start time", "type": "text", "default": "" },
    { "key": "venue", "label": "Venue", "type": "text", "default": "" },
    {
      "key": "setlist",
      "label": "Running order",
      "type": "list",
      "default": [],
      "required": true,
      "layout": "stacked",
      "columns": [
        { "key": "number", "label": "Number", "type": "text" },
        { "key": "title", "label": "Title", "type": "text" },
        { "key": "notes", "label": "Notes", "type": "text" },
        { "key": "type", "label": "Entry type", "type": "text" }
      ],
      "format": "{number} {title}\n{notes}"
    },
    { "key": "status", "label": "Setlist status", "type": "text", "default": "", "hidden": true },
    { "key": "source", "label": "Source", "type": "text", "default": "" },
    { "key": "artwork", "label": "Performance artwork", "type": "url", "default": "", "hidden": true }
  ],
  "doc": {
    "version": 1,
    "name": "Love Live setlist",
    "landscape": false,
    "length": 600,
    "autoLength": true,
    "endSpace": 96,
    "print": { "heat": 0, "copies": 1, "darkness": 128 },
    "elements": [
      {
        "id": "art", "kind": "image", "src": "{{artwork}}", "when": "artwork",
        "x": 16, "y": 16, "w": 112, "h": 164, "rotation": 0, "invert": false,
        "fit": "contain", "frame": "none", "dither": "atkinson",
        "brightness": 0, "contrast": 8, "gamma": 1, "threshold": 128, "group": "ll-event"
      },
      {
        "id": "event", "kind": "text", "text": "{{event}}", "when": "artwork",
        "x": 148, "y": 12, "w": 220, "h": 168, "rotation": 0, "invert": false,
        "font": "IBM Plex Sans JP", "size": 22, "weight": 700, "italic": false,
        "align": "left", "lineHeight": 1.25, "letterSpacing": 0, "fit": "shrink", "group": "ll-event"
      },
      {
        "id": "event-without-art", "kind": "text", "text": "{{event}}", "when": "!artwork",
        "x": 16, "y": 12, "w": 352, "h": 168, "rotation": 0, "invert": false,
        "font": "IBM Plex Sans JP", "size": 25, "weight": 700, "italic": false,
        "align": "left", "lineHeight": 1.25, "letterSpacing": 0, "fit": "shrink", "group": "ll-event"
      },
      {
        "id": "date", "kind": "text", "text": "{{date}}",
        "x": 16, "y": 200, "w": 236, "h": 24, "rotation": 0, "invert": false,
        "font": "IBM Plex Sans JP", "size": 17, "weight": 700, "italic": false,
        "align": "left", "lineHeight": 1.3, "letterSpacing": 0, "group": "ll-meta"
      },
      {
        "id": "performance", "kind": "text", "text": "{{performance}}", "when": "performance",
        "x": 264, "y": 200, "w": 104, "h": 24, "rotation": 0, "invert": false,
        "font": "IBM Plex Sans JP", "size": 17, "weight": 400, "italic": false,
        "align": "right", "lineHeight": 1.3, "letterSpacing": 0, "fit": "shrink", "group": "ll-meta"
      },
      {
        "id": "venue", "kind": "text", "text": "{{venue}}",
        "x": 16, "y": 234, "w": 352, "h": 24, "rotation": 0, "invert": false,
        "font": "IBM Plex Sans JP", "size": 17, "weight": 400, "italic": false,
        "align": "left", "lineHeight": 1.3, "letterSpacing": 0, "group": "ll-meta"
      },
      {
        "id": "divider", "kind": "shape", "shape": "line",
        "x": 16, "y": 274, "w": 352, "h": 2, "rotation": 0, "invert": false,
        "fill": "solid", "stroke": 2, "radius": 0, "group": "ll-meta"
      },
      {
        "id": "footer-rule", "kind": "shape", "shape": "line",
        "x": 16, "y": 308, "w": 352, "h": 1, "rotation": 0, "invert": false,
        "fill": "solid", "stroke": 1, "radius": 0, "group": "ll-source"
      },
      {
        "id": "source", "kind": "text", "text": "{{source}}",
        "x": 264, "y": 326, "w": 104, "h": 20, "rotation": 0, "invert": false,
        "font": "IBM Plex Sans JP", "size": 14, "weight": 400, "italic": false,
        "align": "right", "lineHeight": 1.3, "letterSpacing": 0, "group": "ll-source"
      }
    ],
    "sections": {
      "ll-event": { "name": "Performance" },
      "ll-meta": { "name": "When and where" },
      "ll-source": { "name": "Source" }
    },
    "repeats": [
      {
        "field": "setlist", "y": 286, "gap": 12,
        "variants": {
          "section": [
            { "id": "section", "kind": "text", "text": "{title}", "x": 16, "y": 10, "w": 352, "h": 28, "size": 17, "font": "IBM Plex Sans JP", "weight": 700, "rotation": 0, "invert": false, "italic": false, "align": "left", "lineHeight": 1.4, "letterSpacing": 0 }
          ],
          "song": [
            { "id": "number", "kind": "text", "text": "{number}", "x": 16, "y": 3, "w": 30, "h": 24, "size": 16, "font": "IBM Plex Sans JP", "weight": 400, "rotation": 0, "invert": false, "italic": false, "align": "right", "lineHeight": 1.3, "letterSpacing": 0 },
            { "id": "title", "kind": "text", "text": "{title}", "x": 62, "y": 0, "w": 306, "h": 28, "size": 21, "font": "IBM Plex Sans JP", "weight": 700, "rotation": 0, "invert": false, "italic": false, "align": "left", "lineHeight": 1.3, "letterSpacing": 0 },
            { "id": "notes", "kind": "text", "text": "{notes}", "when": "notes", "x": 62, "y": 31, "w": 306, "h": 21, "size": 15, "font": "IBM Plex Sans JP", "weight": 400, "rotation": 0, "invert": false, "italic": false, "align": "left", "lineHeight": 1.4, "letterSpacing": 0 }
          ],
          "mc": [
            { "id": "title", "kind": "text", "text": "{title}", "x": 62, "y": 0, "w": 306, "h": 23, "size": 16, "font": "IBM Plex Sans JP", "weight": 400, "rotation": 0, "invert": false, "italic": false, "align": "left", "lineHeight": 1.4, "letterSpacing": 0 },
            { "id": "notes", "kind": "text", "text": "{notes}", "when": "notes", "x": 62, "y": 27, "w": 306, "h": 21, "size": 15, "font": "IBM Plex Sans JP", "weight": 400, "rotation": 0, "invert": false, "italic": false, "align": "left", "lineHeight": 1.4, "letterSpacing": 0 }
          ],
          "vtr": [
            { "id": "title", "kind": "text", "text": "{title}", "x": 62, "y": 0, "w": 306, "h": 23, "size": 16, "font": "IBM Plex Sans JP", "weight": 400, "rotation": 0, "invert": false, "italic": false, "align": "left", "lineHeight": 1.4, "letterSpacing": 0 },
            { "id": "notes", "kind": "text", "text": "{notes}", "when": "notes", "x": 62, "y": 27, "w": 306, "h": 21, "size": 15, "font": "IBM Plex Sans JP", "weight": 400, "rotation": 0, "invert": false, "italic": false, "align": "left", "lineHeight": 1.4, "letterSpacing": 0 }
          ],
          "custom": [
            { "id": "title", "kind": "text", "text": "{title}", "x": 62, "y": 0, "w": 306, "h": 23, "size": 16, "font": "IBM Plex Sans JP", "weight": 400, "rotation": 0, "invert": false, "italic": false, "align": "left", "lineHeight": 1.4, "letterSpacing": 0 },
            { "id": "notes", "kind": "text", "text": "{notes}", "when": "notes", "x": 62, "y": 27, "w": 306, "h": 21, "size": 15, "font": "IBM Plex Sans JP", "weight": 400, "rotation": 0, "invert": false, "italic": false, "align": "left", "lineHeight": 1.4, "letterSpacing": 0 }
          ],
          "default": [
            { "id": "title", "kind": "text", "text": "{title}", "x": 62, "y": 0, "w": 306, "h": 28, "size": 21, "font": "IBM Plex Sans JP", "weight": 700, "rotation": 0, "invert": false, "italic": false, "align": "left", "lineHeight": 1.3, "letterSpacing": 0 },
            { "id": "notes", "kind": "text", "text": "{notes}", "when": "notes", "x": 62, "y": 31, "w": 306, "h": 21, "size": 15, "font": "IBM Plex Sans JP", "weight": 400, "rotation": 0, "invert": false, "italic": false, "align": "left", "lineHeight": 1.4, "letterSpacing": 0 }
          ]
        }
      }
    ]
  }
}
