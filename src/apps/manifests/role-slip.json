      "default": "{pick:Villager|Villager|Werewolf|Seer|Knight}",
      "hint": "One role is drawn per copy. Default deck: Villager|Villager|Werewolf|Seer|Knight"
    },
    {
      "key": "rules",
      "label": "Instructions",
      "type": "longtext",
      "default": "Read alone. Fold the role under.\nAct normal. Trust no one."
