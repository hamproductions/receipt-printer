{
  "id": "ham-guest-house",
  "version": 1,
  "name": "Ham’s Guest House",
  "hint": "Welcome and stay guide with Wi-Fi QR, keys, house notes and a checkout list",
  "fields": [
    {
      "key": "house_name",
      "label": "House name",
      "type": "longtext",
      "default": "HAM’S\nPLACE"
    },
    {
      "key": "guest_name",
      "label": "Guest name",
      "type": "text",
      "default": "",
      "required": true,
      "perGuest": true,
      "blankLength": 18
    },
    {
      "key": "arrival_date",
      "label": "Arrival date",
      "type": "date",
      "default": "",
      "required": true,
      "perGuest": true,
      "blankLength": 10
    },
    {
      "key": "departure_date",
      "label": "Departure date",
      "type": "date",
      "default": "",
      "required": true,
      "perGuest": true,
      "blankLength": 10
    },
    {
      "key": "welcome_message",
      "label": "Welcome lines",
      "type": "longtext",
      "default": "Your little Tokyo home.\nMake yourself comfortable. — Ham"
    },
    {
      "key": "wifi_name",
      "label": "Wi-Fi network",
      "type": "text",
      "default": "",
      "required": true,
      "hint": "Shown in the text and encoded in the QR. Save as template to keep it in this browser only."
    },
    {
      "key": "wifi_password",
      "label": "Wi-Fi password",
      "type": "password",
      "default": "",
      "required": true
    },
    {
      "key": "door_pin",
      "label": "Backup PIN",
      "type": "password",
      "default": "",
      "required": true
    },
    {
      "key": "key_notes",
      "label": "Key notes",
      "type": "longtext",
      "default": "Take the physical key as backup.\nPull the door fully closed."
    },
    {
      "key": "house_rules",
      "label": "Good neighbour mode",
      "type": "longtext",
      "default": "After 10 pm: low voices, light feet.\nDarts are a daytime activity.\n\nClose the shoe cabinet gently.\nThe internet fibre lives inside!\n\nKettle OR microwave, not both.\nBreaker: above the shoe cabinet."
    },
    {
      "key": "settle_in",
      "label": "Settle in",
      "type": "longtext",
      "default": "MICROWAVE\nレンジ → choose time → Start\nCheck wattage on the display.\n\nBATH & HOT WATER\nPress Start to enable hot water.\nAsk Ham before filling the bath.\nDrain closed → ふろ自動 to fill\n追い焚き → reheat bath water\nPut the bath cover back after use.\n\nWasher outside; hangers on top.\nEnjoy the books. Handle gently.\nPlease close the toilet lid."
    },
    {
      "key": "out_and_about",
      "label": "Out and about",
      "type": "longtext",
      "default": "ON FOOT, APPROXIMATELY\nIkejiri-Ohashi station     8 min\nNaka-meguro station     15 min\nShibuya                      20 min\n\nBINS: Mon recycling; Tue/Fri burnable.\nUse the separate sorting guide.\nPaper: check collection-point sign."
    },
    {
      "key": "goodbye",
      "label": "Before you head out",
      "type": "longtext",
      "default": "Key? Stove? Lights? Aircon?\nDoor fully closed? You’re good.\n\nNeed anything? Just ask Ham.\nEnjoy your Tokyo stay!"
    }
  ],
