{
  "id": "contact",
  "version": 1,
  "name": "Contact card",
  "hint": "Scan to save the contact",
  "fields": [
    {
      "key": "name",
      "label": "Name",
      "type": "text",
      "default": "Sam Taylor"
    },
    {
      "key": "title",
      "label": "Title",
      "type": "text",
      "default": "Product Designer"
    },
    {
      "key": "phone",
      "label": "Phone",
      "type": "text",
      "default": "+1 555 0100"
    },
    {
      "key": "email",
      "label": "Email",
      "type": "text",
      "default": "sam@example.com"
    },
    {
      "key": "site",
      "label": "Website",
      "type": "url",
      "default": "https://example.com"
    },
    {
      "key": "note",
      "label": "Footer",
      "type": "text",
      "default": "Scan to save my contact"
    }
  ],
  "doc": {
    "version": 1,
    "name": "Contact card",
    "landscape": false,
    "length": 600,
    "autoLength": true,
    "endSpace": 96,
    "elements": [
      {
        "kind": "shape",
        "x": 0,
        "w": 384,
        "h": 112,
        "rotation": 0,
        "invert": false,
        "shape": "rect",
        "fill": "solid",
        "stroke": 0,
        "radius": 0,
        "y": 0,
        "group": "contact-1"
      },
      {
        "kind": "text",
        "x": 0,
        "w": 384,
        "h": 42,
        "rotation": 0,
        "invert": true,
