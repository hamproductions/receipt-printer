    {
      "key": "message",
      "label": "Message",
      "type": "text",
      "default": "HAPPY BIRTHDAY",
      "placeholder": "HAPPY BIRTHDAY",
      "hint": "Short and loud reads best"
    },
    {
      "key": "topEdge",
      "label": "Top zigzag",
      "type": "toggle",
      "default": true
